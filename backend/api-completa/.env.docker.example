# OBLIGATORIO: "docker compose up" no arranca sin este archivo, porque
# SECRET_KEY, DB_PASSWORD y MYSQL_ROOT_PASSWORD no tienen valor por defecto.
# Copia este archivo como .env, en esta misma carpeta (api-completa/),
# y completa esos tres valores:
#
#   Copy-Item .env.docker.example .env     (PowerShell)
#   cp .env.docker.example .env            (Linux/macOS)
#
# Genera SECRET_KEY con: php -r "echo bin2hex(random_bytes(32));"

SECRET_KEY=

# development habilita configuracion local para aprender y depurar.
# En un servidor publico cambialo a production.
APP_ENV=development

TOKEN_LIFETIME=3600

# Origen del frontend autorizado para enviar cookies (CORS).
FRONTEND_ORIGIN=http://localhost:8000

# Credenciales de la base que existe unicamente dentro de Docker.
DB_NAME=inau_talleres
# Definí contraseñas propias. Podés generarlas con: openssl rand -hex 16
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Puertos publicados en la computadora.
API_PORT=127.0.0.1:8002
MYSQL_PORT=127.0.0.1:3308