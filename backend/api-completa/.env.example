# ======================================================================
# .env.example - PLANTILLA (esta SÍ se sube a git)
# ======================================================================
# Copiá este archivo a ".env" y poné tus propios valores:
#
#   cp .env.example .env          (Linux/Mac)
#   copy .env.example .env        (Windows)
#
# El .env real queda fuera de git; este ejemplo es el que le muestra a
# cualquiera que baje el proyecto QUÉ variables necesita, sin revelar
# ningún secreto de verdad.
# ======================================================================
SECRET_KEY=
APP_ENV=development
TOKEN_LIFETIME=3600

FRONTEND_ORIGIN=http://localhost:8000

DB_HOST=database
DB_NAME=inau_talleres
DB_USER=utu_user
DB_PASSWORD=utu_password

API_PORT=8002
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=root_password